# Copy this file to `.env.local` and fill in real values. `.env.local` is gitignored.
# See setup.md for step-by-step instructions.

# --- Contact form (Formspree) ---
# https://formspree.io/f/XXXXXXXX -> use the XXXXXXXX part.
VITE_FORMSPREE_ID=

# --- Sanity CMS ---
# Project ID + dataset from your Sanity project (sanity.io). Studio lives at /studio.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01

# --- Booking ---
# Full Cal.com or Calendly scheduling URL, e.g. https://cal.com/made-by-priest/intro
VITE_BOOKING_URL=
